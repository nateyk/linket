{
    "$schema": "https://opencode.ai/config.json",
    "model": "cloudflare/@cf/qwen/qwen2.5-coder-32b-instruct",
    "experimental": {
        "subagent_depth": 2
    },
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git"
    ],
    "lsp": true,
    "mcp": {
        "shadcn": {
            "type": "local",
            "command": [
                "npx",
                "--prefix",
                ".",
                "shadcn",
                "mcp"
            ],
            "enabled": true
        },
        "filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/home/nate/projects/linket"
            ],
            "enabled": true
        },
        "github": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "environment": {
                "GITHUB_TOKEN": "env:GITHUB_TOKEN"
            },
            "enabled": true
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "ddev",
                "exec",
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}